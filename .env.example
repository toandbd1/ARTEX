# Cấu hình triển khai Docker (sao chép thành .env)
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Cập nhật qua GitHub Release riêng tư (chỉ backend đọc; token cần quyền Contents: read của Hinln/ARTEX)
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM (điền một trong hai hoặc cả hai; cũng có thể để trống và cấu hình trong UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
